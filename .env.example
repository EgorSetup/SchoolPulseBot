# MAX Bot API token (обязательный)
MAX_BOT_TOKEN=your_bot_token_here

# Webhook URL — https endpoint, на который MAX будет присылать события
WEBHOOK_URL=https://your-domain.com/webhook

# Секрет для верификации вебхуков (опционально, но рекомендуется)
WEBHOOK_SECRET=your-webhook-secret

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_pulse_bot

# Server settings
HOST=0.0.0.0
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
